        <mxCell id="op_laps" value="&lt;b&gt;Local admin passwords&lt;/b&gt;&lt;br&gt;Windows LAPS: Present" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="onprem">
          <mxGeometry x="14" y="274" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="op_pwd" value="&lt;b&gt;Password protection on DCs&lt;/b&gt;&lt;br&gt;Missing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="onprem">
          <mxGeometry x="14" y="352" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="op_adfs" value="&lt;b&gt;AD FS&lt;/b&gt;&lt;br&gt;Retire: move to password hash sync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="onprem">
          <mxGeometry x="14" y="430" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="op_adcs" value="&lt;b&gt;AD CS&lt;/b&gt;&lt;br&gt;1 CA(s), 1 risky template(s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="onprem">
          <mxGeometry x="14" y="508" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="op_ex" value="&lt;b&gt;Exchange on-premises&lt;/b&gt;&lt;br&gt;3 server(s); target Exchange Online" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="onprem">
          <mxGeometry x="14" y="586" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="bridge" value="Identity bridge" style="swimlane;html=1;startSize=28;rounded=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;swimlaneFillColor=#faf6fc;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="328" height="430" as="geometry" />
        </mxCell>
        <mxCell id="br_sync" value="&lt;b&gt;Microsoft Entra Connect Sync&lt;/b&gt;&lt;br&gt;Consider Cloud Sync (see X02)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="bridge">
          <mxGeometry x="14" y="40" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="br_upn" value="&lt;b&gt;Routable UPNs&lt;/b&gt;&lt;br&gt;1 users on non-routable suffixes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="bridge">
          <mxGeometry x="14" y="118" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="br_join" value="&lt;b&gt;Hybrid join (device SCP)&lt;/b&gt;&lt;br&gt;Present" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="bridge">
          <mxGeometry x="14" y="196" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="br_krb" value="&lt;b&gt;Microsoft Entra Kerberos&lt;/b&gt;&lt;br&gt;Cloud Kerberos trust: Partial" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="bridge">
          <mxGeometry x="14" y="274" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="br_mdi" value="&lt;b&gt;Defender for Identity sensors&lt;/b&gt;&lt;br&gt;Verify: not visible in AD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="bridge">
          <mxGeometry x="14" y="352" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cloud" value="Microsoft Entra ID and Microsoft 365 (target)" style="swimlane;html=1;startSize=28;rounded=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;swimlaneFillColor=#faf6fc;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="840" y="90" width="328" height="508" as="geometry" />
        </mxCell>
        <mxCell id="cl_tenant" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;contoso.onmicrosoft.com" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="cloud">
          <mxGeometry x="14" y="40" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cl_auth" value="&lt;b&gt;Cloud authentication&lt;/b&gt;&lt;br&gt;Password hash sync + Conditional Access + MFA (after AD FS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="cloud">
          <mxGeometry x="14" y="118" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cl_whfb" value="&lt;b&gt;Passwordless&lt;/b&gt;&lt;br&gt;Windows Hello for Business (cloud Kerberos trust), FIDO2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="cloud">
          <mxGeometry x="14" y="196" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cl_devices" value="&lt;b&gt;Devices&lt;/b&gt;&lt;br&gt;Intune + Autopilot, Entra join for new PCs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="cloud">
          <mxGeometry x="14" y="274" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cl_apps" value="&lt;b&gt;Apps&lt;/b&gt;&lt;br&gt;Entra app proxy / Private Access for on-premises apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="cloud">
          <mxGeometry x="14" y="352" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="cl_m365" value="&lt;b&gt;Microsoft 365&lt;/b&gt;&lt;br&gt;Exchange Online (migrate mailboxes)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="cloud">
          <mxGeometry x="14" y="430" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="784" width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend_dc" value="In place" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="810" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="legend_warn" value="Needs work" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="265" y="810" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="legend_bad" value="Missing / recommended" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="810" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="legend_external" value="Target or not visible from AD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="695" y="810" width="200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="users, groups&lt;br&gt;password hashes" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;fontSize=9;" edge="1" parent="1" source="op_forest" target="br_sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#82b366;fontSize=9;" edge="1" parent="1" source="br_sync" target="cl_tenant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=none;html=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="op_dcs" target="br_mdi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="endArrow=none;html=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="br_krb" target="cl_whfb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="endArrow=none;html=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="br_join" target="cl_devices">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="migrate (Staged Rollout)" style="endArrow=block;endFill=1;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="op_adfs" target="cl_auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="migrate mailboxes" style="endArrow=block;endFill=1;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="op_ex" target="cl_m365">
