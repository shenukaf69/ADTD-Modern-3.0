  <diagram id="page1" name="Summary">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1370" pageHeight="1210" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Active Directory topology - contoso.com" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="facts" value="&lt;b&gt;Collected:&lt;/b&gt; 2026-09-27 09:28 from dc01.contoso.com&lt;br&gt;&lt;b&gt;Forest level:&lt;/b&gt; Windows Server 2016&lt;br&gt;&lt;b&gt;Schema:&lt;/b&gt; Windows Server 2025&lt;br&gt;&lt;b&gt;Domains:&lt;/b&gt; 2 &amp;#183; &lt;b&gt;Sites:&lt;/b&gt; 5 &amp;#183; &lt;b&gt;Subnets:&lt;/b&gt; 6 &amp;#183; &lt;b&gt;Site links:&lt;/b&gt; 3&lt;br&gt;&lt;b&gt;Domain controllers:&lt;/b&gt; 6 (1 read-only, 5 global catalogs)&lt;br&gt;&lt;br&gt;&lt;b&gt;DC operating systems&lt;/b&gt;&lt;br&gt;Windows Server 2012 R2: 1&lt;br&gt;Windows Server 2016: 1&lt;br&gt;Windows Server 2019: 1&lt;br&gt;Windows Server 2022: 1&lt;br&gt;Windows Server 2025: 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="460" height="260" as="geometry" />
        </mxCell>
        <mxCell id="findings" value="&lt;b&gt;Findings (45)&lt;/b&gt;&lt;table style=&apos;font-size:11px;margin-top:4px&apos;&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S02&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;krbtgt password is old&lt;/b&gt;&lt;br&gt;krbtgt password is older than 180 days in: contoso.com (400 days).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;H11&lt;br&gt;Health&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;A site is not in any site link&lt;/b&gt;&lt;br&gt;Not in any site link: Auckland.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;H07&lt;br&gt;Health&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;A domain has only one writable domain controller&lt;/b&gt;&lt;br&gt;Only one writable DC in: emea.contoso.com.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;H06&lt;br&gt;Health&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;SYSVOL still replicates with FRS&lt;/b&gt;&lt;br&gt;SYSVOL uses FRS in: emea.contoso.com.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;H01&lt;br&gt;Health&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Domain controllers run an unsupported operating system&lt;/b&gt;&lt;br&gt;1 domain controller(s) run an unsupported OS: EMEADC1 (Windows Server 2012 R2).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S31&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Seamless SSO key has not been rolled over for more than 30 days&lt;/b&gt;&lt;br&gt;AZUREADSSOACC key age: contoso.com 120 days.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;H17&lt;br&gt;Health&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Exchange servers are out of support&lt;/b&gt;&lt;br&gt;1 Exchange server(s) out of support: EX2019 (Exchange 2019).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S27&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Computers run an unsupported Windows version&lt;/b&gt;&lt;br&gt;2 computer(s) run an unsupported Windows version: contoso.com\WS02 (Windows 10), contoso.com\OLD01 (Windows Server 2012 R2).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S12&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Unconstrained Kerberos delegation on non-DC accounts&lt;/b&gt;&lt;br&gt;1 non-DC account(s) are trusted for unconstrained delegation: contoso.com\APP01.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S10&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Accounts do not require Kerberos pre-authentication (AS-REP roasting)&lt;/b&gt;&lt;br&gt;1 account(s) don&amp;#39;t require Kerberos pre-authentication: contoso.com\asrep.user.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S05&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Privileged accounts have a service principal name (Kerberoastable)&lt;/b&gt;&lt;br&gt;1 privileged account(s) have an SPN: contoso.com\svc.sql.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#b85450;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;High&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S30&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Certificate templates let requesters choose the subject (possible ESC1)&lt;/b&gt;&lt;br&gt;1 published certificate template(s) let the requester set the subject and can be used to sign in: VulnTemplate.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S22&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Any user can join computers to the domain (MachineAccountQuota)&lt;/b&gt;&lt;br&gt;MachineAccountQuota is above 0 in: contoso.com (10).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;X04&lt;br&gt;Hybrid&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Users have non-routable UPN suffixes&lt;/b&gt;&lt;br&gt;1 enabled user(s) have non-routable UPN suffixes: @contoso.local (1).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;X03&lt;br&gt;Hybrid&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;AD FS is (or was) deployed&lt;/b&gt;&lt;br&gt;AD FS configuration container found in: contoso.com.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;H09&lt;br&gt;Health&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;The Active Directory Recycle Bin is not enabled&lt;/b&gt;&lt;br&gt;The Active Directory Recycle Bin is not enabled.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;H04&lt;br&gt;Health&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Forest or domain functional level is below Windows Server 2016&lt;/b&gt;&lt;br&gt;Functional level below Windows Server 2016: Domain emea.contoso.com: Windows Server 2012 R2.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;H02&lt;br&gt;Health&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Domain controller support ends within 12 months&lt;/b&gt;&lt;br&gt;1 domain controller(s) reach end of support within 12 months: NYDC1 (Windows Server 2016, 2027-01-12).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S29&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Pre-Windows 2000 Compatible Access contains Anonymous or Everyone&lt;/b&gt;&lt;br&gt;Pre-Windows 2000 Compatible Access includes Anonymous or Everyone in: contoso.com.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S28&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;The Guest account is enabled&lt;/b&gt;&lt;br&gt;Guest is enabled in: contoso.com.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S26&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Some computers have no LAPS password&lt;/b&gt;&lt;br&gt;80% of 5 Windows member computers have a LAPS password; 1 don&amp;#39;t: contoso.com\WS02.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S23&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Default domain password policy is weak&lt;/b&gt;&lt;br&gt;Weak default password policy: contoso.com: minimum length 7, no lockout.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S21&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Accounts with SID history&lt;/b&gt;&lt;br&gt;1 account(s) carry SID history: contoso.com\migrated.user.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S17&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Accounts limited to RC4 Kerberos encryption&lt;/b&gt;&lt;br&gt;2 account(s) only allow RC4 for Kerberos: contoso.com\svc.web, contoso.com\AZUREADSSOACC.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S14&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Accounts that do not need a password&lt;/b&gt;&lt;br&gt;1 account(s) don&amp;#39;t require a password: contoso.com\nopwd.user.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S13&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Accounts trusted to authenticate for delegation (protocol transition)&lt;/b&gt;&lt;br&gt;1 account(s) use protocol transition: .&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S11&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;User accounts with service principal names (Kerberoastable)&lt;/b&gt;&lt;br&gt;1 user account(s) have SPNs: contoso.com\svc.web.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S09&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Operator groups have members&lt;/b&gt;&lt;br&gt;Operator groups have 1 member(s): contoso.com Account Operators: helpdesk1.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S08&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Privileged accounts are not being used&lt;/b&gt;&lt;br&gt;1 enabled privileged account(s) have not signed in for 90 days: contoso.com\da.stale.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&apos;color:#d79b00;font-weight:bold;padding-right:8px;vertical-align:top&apos;&gt;Medium&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding-right:8px&apos;&gt;S07&lt;br&gt;Security&lt;/td&gt;&lt;td style=&apos;vertical-align:top&apos;&gt;&lt;b&gt;Privileged accounts with old or non-expiring passwords&lt;/b&gt;&lt;br&gt;2 privileged account(s) have a password older than a year or set to never expire: contoso.com\Administrator, contoso.com\svc.sql.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;i&gt;15 more in the HTML report.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="530" y="70" width="760" height="1060" as="geometry" />
        </mxCell>
